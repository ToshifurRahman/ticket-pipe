# --- API server ---
# Port the API (and the built web app) listens on. Local: 3000
PORT=
# Postgres connection string. Local (docker compose): postgresql://postgres:postgres@localhost:5433/ticket_pipe
DATABASE_URL=

# --- Queue (AWS SQS) ---
# LocalStack URL for local runs; leave unset in production to use AWS. Local: http://localhost:4566
SQS_ENDPOINT=
# Main queue the worker reads. Local: ticket-processing
SQS_QUEUE_NAME=
# Dead-letter queue for messages that keep failing. Local: ticket-processing-dlq
SQS_DLQ_NAME=
# How many tickets one worker processes at once. Local: 10
WORKER_CONCURRENCY=

# --- Redis (ops sessions, rate limits, socket rooms) ---
# Local: redis://localhost:6379
REDIS_URL=

# --- AWS credentials ---
# LocalStack accepts any value (test/test). Use real IAM keys only in production.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM providers ---
# All calls go through the Portkey gateway.
PORTKEY_API_KEY=
# Key for the "google" gateway (Gemini).
GOOGLE_API_KEY=
# Primary provider: "google" or "groq", and its model (e.g. a Gemini flash model).
PRIMARY_GATEWAY=
PRIMARY_MODEL=
# Backup provider, used when the primary fails or times out. BACKUP_API_KEY is the Groq key.
# No key means no backup. Example model: openai/gpt-oss-20b
BACKUP_GATEWAY=
BACKUP_API_KEY=
BACKUP_MODEL=
# Per-call timeout in milliseconds. Default: 30000
AI_TIMEOUT_MS=
# LLM_MODE=fake returns canned triage/draft output with no provider call (UI and e2e tests).
# Refused when NODE_ENV=production. Add [fake:invalid-triage] or [fake:invalid-draft] to a
# ticket description to force that stage to return invalid output (-> needs_attention).
# LLM_MODE=real
# LLM_FAKE_DELAY_MS=1500

# --- Ops console ---
# Token staff sign in with at /ops. Production needs 32+ characters: openssl rand -base64 32
OPS_TOKEN=dev-ops-token

# --- Ops email alerts (SNS) ---
# Alerts stay off until SNS_TOPIC_ARN is set; `bun run setup` creates the topic in LocalStack
# and prints its ARN. Local: http://localhost:4566
SNS_ENDPOINT=
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ticket-needs-attention
# SNS_ALERT_MAX_PER_HOUR=20

# --- Customer email ---
# Unset MAIL_DRIVER turns the "email me" card off.
#   smtp   -> Mailpit (docker compose up -d; inbox at http://localhost:8025)
#   brevo  -> production (HTTPS API). Needs BREVO_API_KEY and a sender verified in Brevo.
#   memory -> tests
MAIL_DRIVER=
# SMTP server for the smtp driver. Local (Mailpit): smtp://localhost:1025
SMTP_URL=
# Sender address and display name on outgoing mail.
MAIL_FROM=support@relay.com
MAIL_FROM_NAME=Relay
# Public origin of the site, used for links in emails (no trailing slash).
PUBLIC_SITE_URL=
