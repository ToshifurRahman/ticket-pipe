PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ticket_pipe
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_NAME=ticket-processing
SQS_DLQ_NAME=ticket-processing-dlq
WORKER_CONCURRENCY=10
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Ops email alerts (story 5.7). Alerts are off until SNS_TOPIC_ARN is set; `bun run setup`
# creates the topic in LocalStack and prints its ARN.
SNS_ENDPOINT=http://localhost:4566
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ticket-needs-attention
# SNS_ALERT_MAX_PER_HOUR=20
# Ops console sign-in (story 6.5). Production requires 32+ characters:
#   openssl rand -base64 32
OPS_TOKEN=dev-ops-token
PORTKEY_API_KEY=your_portkey_key_here
GOOGLE_API_KEY=your_google_api_key_here
PRIMARY_GATEWAY=google
PRIMARY_MODEL=gemini-3.8-flash
BACKUP_GATEWAY=groq
BACKUP_API_KEY=your_backup_groq_key_here
BACKUP_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=30000
# LLM_MODE=fake returns canned triage/draft output with no provider call (UI / e2e tests).
# Refused when NODE_ENV=production. "[fake:invalid-triage]" or "[fake:invalid-draft]" in a
# ticket description makes that stage return invalid output (-> needs_attention).
# LLM_MODE=real
# LLM_FAKE_DELAY_MS=1500

# Public origin of the deployed site (no trailing slash). Read at web build time to make the
# og:image / og:url tags absolute. Unset → relative URLs and a build warning.
# VITE_SITE_URL=https://your-service.onrender.com

# Customer email (story 6.9). Unset MAIL_DRIVER turns the "email me" card off.
#   smtp   -> Mailpit (docker compose up -d; inbox at http://localhost:8025)
#   brevo  -> production (HTTPS API; Render free blocks SMTP). Needs BREVO_API_KEY and a
#             sender address verified in Brevo.
#   memory -> tests
MAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=support@relay.com
MAIL_FROM_NAME=Relay
PUBLIC_SITE_URL=http://localhost:3000
# BREVO_API_KEY=
# MAIL_DAILY_CAP=250
