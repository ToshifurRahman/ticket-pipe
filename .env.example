# Every variable the API, the worker and the scripts read. apps/api/src/lib/config.ts validates
# them once at startup; a missing or invalid one stops the process and the message names it.
# An empty value (KEY=) counts as unset. tests/guards/env-example.test.ts keeps this file and
# the schema in step.

# --- API server ---
# Port the API (and the built web app) listens on. Default: 3000
PORT=
# "production" turns on the production checks (OPS_TOKEN length, brevo-only mail, no fake LLM).
NODE_ENV=
# Postgres connection string (required). Local (docker compose): postgresql://postgres:postgres@localhost:5433/ticket_pipe
DATABASE_URL=

# --- Queue (AWS SQS) ---
# LocalStack URL for local runs. Leave unset in production to use AWS. Local: http://localhost:4566
SQS_ENDPOINT=
# Main queue the worker reads (required). Local: ticket-processing
SQS_QUEUE_NAME=
# Dead-letter queue for messages that keep failing. Default: <SQS_QUEUE_NAME>-dlq
SQS_DLQ_NAME=
# How many tickets one worker processes at once. Default: 10
WORKER_CONCURRENCY=

# --- Redis (ops sessions, rate limits, socket rooms) ---
# Required. Local: redis://localhost:6379
REDIS_URL=

# --- AWS credentials ---
AWS_REGION=
# Required unless SQS_ENDPOINT is set. With a LocalStack endpoint they default to "test".
# Production: real IAM keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM providers ---
# All calls go through the Portkey gateway. Required while LLM_MODE is real (the default).
PORTKEY_API_KEY=
# Key for the "google" gateway (Gemini). Required while LLM_MODE is real.
GOOGLE_API_KEY=
# Key for the "groq" gateway when it is the primary provider.
GROQ_API_KEY=
# Primary provider: "google" or "groq" (default groq), and its model (default openai/gpt-oss-20b).
PRIMARY_GATEWAY=
PRIMARY_MODEL=
# Backup provider, used when the primary fails or times out. BACKUP_API_KEY is the Groq key.
# No key means no backup. Example model: openai/gpt-oss-20b
BACKUP_GATEWAY=
BACKUP_API_KEY=
BACKUP_MODEL=
# Per-call timeout in milliseconds. Default: 30000
AI_TIMEOUT_MS=
# LLM_MODE=fake returns canned triage/draft output with no provider call (UI and e2e tests).
# Refused when NODE_ENV=production. Add [fake:invalid-triage] or [fake:invalid-draft] to a
# ticket description to force that stage to return invalid output (-> needs_attention).
# LLM_MODE=real
# Delay of a fake call in milliseconds. Default: 1500
# LLM_FAKE_DELAY_MS=1500

# --- Ops console ---
# Token staff sign in with at /ops. Production needs 32+ characters: openssl rand -base64 32
OPS_TOKEN=dev-ops-token

# --- Ops email alerts (SNS) ---
# Alerts stay off until SNS_TOPIC_ARN is set; `bun --filter @ticket-pipe/api setup` creates the topic in LocalStack
# and prints its ARN. Local: http://localhost:4566. Unset in production uses AWS.
SNS_ENDPOINT=
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ticket-needs-attention
# At most this many alerts per hour. Default: 20
# SNS_ALERT_MAX_PER_HOUR=20

# --- Customer email ---
# Unset MAIL_DRIVER turns the "email me" card off.
#   smtp   -> Mailpit (docker compose up -d; inbox at http://localhost:8025)
#   brevo  -> production (HTTPS API). Needs BREVO_API_KEY and a sender verified in Brevo.
#   memory -> tests
MAIL_DRIVER=
# SMTP server for the smtp driver. Default (Mailpit): smtp://localhost:1025
SMTP_URL=
# Sender address and display name on outgoing mail. Use an address verified with your provider.
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Relay
# API key for the brevo driver (required when MAIL_DRIVER=brevo).
BREVO_API_KEY=
# Customer emails the API sends per day, a guard against runaway sending. Default: 250
MAIL_DAILY_CAP=
# Public origin of the site, used for links in emails (no trailing slash).
# Required when MAIL_DRIVER is set.
PUBLIC_SITE_URL=

# --- Bot check ---
# Cloudflare Turnstile secret key (server side). Validated here; no API route reads it yet.
TURNSTILE_SECRET_KEY=

# --- Web build (read by Vite, not by the API) ---
# Turnstile site key shown in the browser. Unset uses a Cloudflare test key.
# VITE_TURNSTILE_SITE_KEY=
# Cloudflare Web Analytics token. Leave unset to send no analytics.
# VITE_CF_ANALYTICS_TOKEN=
# Public origin used for canonical links and the sitemap.
# VITE_SITE_URL=
