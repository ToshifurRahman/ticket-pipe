{
  "$description": "Relay colour tokens (Carbon Set, green stock). Dark only: the Relay Full Demo's palette is the single theme. Two tiers here: primitive -> semantic. Each semantic and component token names the CSS custom properties it emits in $extensions.relay.css. Edit here, then run `bun run tokens`.",
  "primitive": {
    "color": {
      "forest": { "$type": "color", "$value": "#08130F", "$description": "Carbon ground, a green-black. Also the ink on a light ply." },
      "forest-2": { "$type": "color", "$value": "#0E1D17" },
      "forest-3": { "$type": "color", "$value": "#152A21" },
      "form-ground": { "$type": "color", "$value": "#0B1511", "$description": "The ground a service form is printed on: a touch lighter than the page, darker than a card." },
      "form-rule": { "$type": "color", "$value": "#1F3A2E", "$description": "Ruling inside a form and its outer edge (decorative). A field boundary uses rule-forest instead: this is about 1.5:1." },
      "form-mute": { "$type": "color", "$value": "#A3CCB7", "$description": "Secondary text on a form." },
      "hair-forest": { "$type": "color", "$value": "#1D3529", "$description": "Form ruling on carbon (decorative)." },
      "rule-forest": { "$type": "color", "$value": "#5E8A73", "$description": "Control boundary on carbon, 3:1+." },
      "bone": { "$type": "color", "$value": "#E8F3EC", "$description": "Ink on carbon." },
      "mute-forest": { "$type": "color", "$value": "#93AE9F", "$description": "Secondary text on carbon." },
      "coral": { "$type": "color", "$value": "#FF7062", "$description": "Urgent on carbon." },
      "ply-bone": { "$type": "color", "$value": "#E4EEE8", "$description": "Received." },
      "ply-mint": { "$type": "color", "$value": "#34C98B", "$description": "Triaged." },
      "ply-orange": { "$type": "color", "$value": "#FF7A1A", "$description": "Drafted." },
      "ply-green": { "$type": "color", "$value": "#166534", "$description": "Replied." },
      "ply-yellow": { "$type": "color", "$value": "#FFD84D", "$description": "The live ply." },
      "ply-edge": { "$type": "color", "$value": "#3FA766", "$description": "The reply's edge." },
      "hold-forest": { "$type": "color", "$value": "#56645D", "$description": "On hold: a grey-green slab with ink on it." },
            "ink-on-ply": { "$type": "color", "$value": "#04140C" },
      "ink-on-orange": { "$type": "color", "$value": "#1A0A00" },
      "ink-on-yellow": { "$type": "color", "$value": "#1A1400" },
      "hero": { "$type": "color", "$value": "#044F34", "$description": "The hero and top bar band, same on both sides." },
      "billing": { "$type": "color", "$value": "#F2B84B" },
      "account": { "$type": "color", "$value": "#B79CFF" },
      "bug": { "$type": "color", "$value": "#FF8A7A" },
      "tech": { "$type": "color", "$value": "#7FB0FF" },
      "feature": { "$type": "color", "$value": "#4FD9CB" },
      "low": { "$type": "color", "$value": "#C9D6CF" },
      "med": { "$type": "color", "$value": "#F5DD5A" },
      "high": { "$type": "color", "$value": "#FFA04D" }
    }
  },
  "semantic": {
    "surface": {
      "page": { "$type": "color", "$value": "{primitive.color.forest}", "$extensions": { "relay.css": ["background"] } },
      "card": { "$type": "color", "$value": "{primitive.color.forest-2}", "$extensions": { "relay.css": ["card"] } },
      "raised": { "$type": "color", "$value": "{primitive.color.forest-3}", "$extensions": { "relay.css": ["secondary", "muted", "accent"] } },
      "form": { "$type": "color", "$value": "{primitive.color.form-ground}", "$extensions": { "relay.css": ["form"] } },
      "popover": { "$type": "color", "$value": "{primitive.color.forest-2}", "$extensions": { "relay.css": ["popover"] } },
      "overlay": { "$type": "color", "$value": "{primitive.color.forest}", "$extensions": { "relay.css": ["overlay"] } }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{primitive.color.bone}", "$extensions": { "relay.css": ["foreground", "card-foreground", "popover-foreground", "secondary-foreground", "accent-foreground", "success"] } },
      "secondary": { "$type": "color", "$value": "{primitive.color.mute-forest}", "$extensions": { "relay.css": ["muted-foreground"] } },
      "form-secondary": { "$type": "color", "$value": "{primitive.color.form-mute}", "$extensions": { "relay.css": ["form-muted"] } },
      "tertiary": { "$type": "color", "$value": "{primitive.color.mute-forest}", "$description": "Kept for the contrast validator; the app has one secondary text tone (muted-foreground), so it emits no CSS." },
      "link": { "$type": "color", "$value": "{primitive.color.bone}", "$extensions": { "relay.css": ["link"] } },
      "on-action": { "$type": "color", "$value": "{primitive.color.forest}", "$extensions": { "relay.css": ["primary-foreground"] } },
      "on-urgent": { "$type": "color", "$value": "{primitive.color.forest}", "$extensions": { "relay.css": ["destructive-foreground"] } }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{primitive.color.bone}", "$extensions": { "relay.css": ["primary"] } },
      "urgent": { "$type": "color", "$value": "{primitive.color.coral}", "$description": "Form red: live or urgent only. Field errors count as urgent (they need the visitor's action now).", "$extensions": { "relay.css": ["destructive", "warning", "stamp-urgent"] } }
    },
    "border": {
      "default": { "$type": "color", "$value": "{primitive.color.hair-forest}", "$extensions": { "relay.css": ["border", "rule"] } },
      "form": { "$type": "color", "$value": "{primitive.color.form-rule}", "$extensions": { "relay.css": ["form-rule"] } },
      "strong": { "$type": "color", "$value": "{primitive.color.rule-forest}", "$extensions": { "relay.css": ["input"] } },
      "focus": { "$type": "color", "$value": "{primitive.color.bone}", "$extensions": { "relay.css": ["ring"] } }
    },
    "ply": {
      "received": { "$type": "color", "$value": "{primitive.color.ply-bone}", "$extensions": { "relay.css": ["ply-received"] } },
      "received-text": { "$type": "color", "$value": "{primitive.color.forest}", "$extensions": { "relay.css": ["ply-received-foreground"] } },
      "triaged": { "$type": "color", "$value": "{primitive.color.ply-mint}", "$extensions": { "relay.css": ["ply-triaged"] } },
      "triaged-text": { "$type": "color", "$value": "{primitive.color.ink-on-ply}", "$extensions": { "relay.css": ["ply-triaged-foreground"] } },
      "drafted": { "$type": "color", "$value": "{primitive.color.ply-orange}", "$extensions": { "relay.css": ["ply-drafted"] } },
      "drafted-text": { "$type": "color", "$value": "{primitive.color.ink-on-orange}", "$extensions": { "relay.css": ["ply-drafted-foreground"] } },
      "live": { "$type": "color", "$value": "{primitive.color.ply-yellow}", "$extensions": { "relay.css": ["ply-live"] } },
      "live-text": { "$type": "color", "$value": "{primitive.color.ink-on-yellow}", "$extensions": { "relay.css": ["ply-live-foreground"] } },
      "replied": { "$type": "color", "$value": "{primitive.color.ply-green}", "$extensions": { "relay.css": ["ply-replied"] } },
      "replied-text": { "$type": "color", "$value": "{primitive.color.bone}", "$extensions": { "relay.css": ["ply-replied-foreground"] } },
      "replied-edge": { "$type": "color", "$value": "{primitive.color.ply-edge}", "$extensions": { "relay.css": ["ply-replied-edge"] } },
      "on-hold": { "$type": "color", "$value": "{primitive.color.hold-forest}", "$extensions": { "relay.css": ["ply-on-hold"] } },
      "on-hold-text": { "$type": "color", "$value": "{primitive.color.bone}", "$extensions": { "relay.css": ["ply-on-hold-foreground"] } },
      "live-ink": { "$type": "color", "$value": "{primitive.color.ply-yellow}", "$extensions": { "relay.css": ["ply-live-ink"] } }
    },
    "hero": {
      "hero": { "$type": "color", "$value": "{primitive.color.hero}", "$extensions": { "relay.css": ["hero"] } },
      "hero-text": { "$type": "color", "$value": "{primitive.color.bone}", "$extensions": { "relay.css": ["hero-foreground"] } }
    },
    "topic": {
      "billing": { "$type": "color", "$value": "{primitive.color.billing}", "$extensions": { "relay.css": ["topic-billing"] } },
      "account": { "$type": "color", "$value": "{primitive.color.account}", "$extensions": { "relay.css": ["topic-account"] } },
      "bug": { "$type": "color", "$value": "{primitive.color.bug}", "$extensions": { "relay.css": ["topic-bug"] } },
      "tech": { "$type": "color", "$value": "{primitive.color.tech}", "$extensions": { "relay.css": ["topic-tech"] } },
      "feature": { "$type": "color", "$value": "{primitive.color.feature}", "$extensions": { "relay.css": ["topic-feature"] } }
    },
    "priority": {
      "low": { "$type": "color", "$value": "{primitive.color.low}", "$extensions": { "relay.css": ["priority-low"] } },
      "medium": { "$type": "color", "$value": "{primitive.color.med}", "$extensions": { "relay.css": ["priority-medium"] } },
      "high": { "$type": "color", "$value": "{primitive.color.high}", "$extensions": { "relay.css": ["priority-high"] } },
      "urgent": { "$type": "color", "$value": "{primitive.color.coral}", "$extensions": { "relay.css": ["priority-urgent"] } }
    },
    "topic-fill": {
      "billing": { "$type": "color", "$value": "{primitive.color.billing}", "$description": "Bright topic colour for use as a fill, the same on both sides.", "$extensions": { "relay.css": ["topic-billing-fill"] } },
      "account": { "$type": "color", "$value": "{primitive.color.account}", "$description": "Bright topic colour for use as a fill, the same on both sides.", "$extensions": { "relay.css": ["topic-account-fill"] } },
      "bug": { "$type": "color", "$value": "{primitive.color.bug}", "$description": "Bright topic colour for use as a fill, the same on both sides.", "$extensions": { "relay.css": ["topic-bug-fill"] } },
      "tech": { "$type": "color", "$value": "{primitive.color.tech}", "$description": "Bright topic colour for use as a fill, the same on both sides.", "$extensions": { "relay.css": ["topic-tech-fill"] } },
      "feature": { "$type": "color", "$value": "{primitive.color.feature}", "$description": "Bright topic colour for use as a fill, the same on both sides.", "$extensions": { "relay.css": ["topic-feature-fill"] } }
    },
    "priority-fill": {
      "low": { "$type": "color", "$value": "{primitive.color.low}", "$description": "Bright priority colour for use as a fill, the same on both sides.", "$extensions": { "relay.css": ["priority-low-fill"] } },
      "medium": { "$type": "color", "$value": "{primitive.color.med}", "$description": "Bright priority colour for use as a fill, the same on both sides.", "$extensions": { "relay.css": ["priority-medium-fill"] } },
      "high": { "$type": "color", "$value": "{primitive.color.high}", "$description": "Bright priority colour for use as a fill, the same on both sides.", "$extensions": { "relay.css": ["priority-high-fill"] } },
      "urgent": { "$type": "color", "$value": "{primitive.color.coral}", "$description": "Bright priority colour for use as a fill, the same on both sides.", "$extensions": { "relay.css": ["priority-urgent-fill"] } }
    }
  }
}
