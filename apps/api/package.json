{
  "name": "@ticket-pipe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "worker": "bun --env-file=../../.env --watch src/worker.ts",
    "setup": "bun --env-file=../../.env scripts/setup-infra.ts",
    "migrate": "bun --env-file=../../.env scripts/migrate.ts",
    "purge": "bun --env-file=../../.env scripts/purge.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1147.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@hono/zod-validator": "^0.9.1",
    "@socket.io/bun-engine": "^0.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.1",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "portkey-ai": "^3.1.0",
    "redis": "^6.3.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "socket.io-client": "^4.8.4"
  }
}
