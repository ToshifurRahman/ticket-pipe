{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QueueRoundTrip",
      "Effect": "Allow",
      "Action": ["sqs:GetQueueUrl", "sqs:SendMessage", "sqs:ReceiveMessage", "sqs:DeleteMessage"],
      "Resource": [
        "arn:aws:sqs:<region>:<account-id>:<main-queue>",
        "arn:aws:sqs:<region>:<account-id>:<smoke-queue>"
      ]
    },
    {
      "Sid": "OpsAlertPublish",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:<region>:<account-id>:<topic>"
    }
  ]
}
