{
  "name": "ticket-pipe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc --noEmit -p apps/api && bun --filter @relay/web build",
    "start": "bun --filter @relay/api start",
    "start:api": "bun --filter @relay/api start:api",
    "start:worker": "bun --filter @relay/api start:worker",
    "test:e2e": "playwright test",
    "test:image": "bun scripts/image-smoke.ts",
    "lighthouse": "bun scripts/lighthouse.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "bun --filter '*' test",
    "typecheck": "tsc --noEmit -p apps/api && tsc -b apps/web && tsc --noEmit -p .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.758.0",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.4",
    "@types/pg": "^8.11.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pg": "^8.13.3",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "zod": "^4.6.5"
  }
}
