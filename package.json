{
  "name": "ticket-pipe",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env --watch src/index.ts",
    "worker": "bun --env-file=.env --watch src/worker.ts",
    "setup": "bun --env-file=.env scripts/setup-infra.ts",
    "migrate": "bun --env-file=.env scripts/migrate.ts",
    "purge": "bun --env-file=.env scripts/purge.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "prepare": "husky install",
    "build": "cd web && bun install --frozen-lockfile && bun run build",
    "web:dev": "cd web && bun run dev",
    "test:web": "cd web && bun run test",
    "test:e2e": "playwright test",
    "brand:assets": "bun scripts/render-brand-assets.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1147.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@hono/zod-validator": "^0.9.1",
    "@socket.io/bun-engine": "^0.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "hono": "^4.13.13",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "portkey-ai": "^3.1.0",
    "redis": "^6.3.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "1.64.0",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.11.11",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.5.3",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
